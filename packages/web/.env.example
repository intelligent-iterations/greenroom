# Firebase web config. Safe to expose — access is governed by firestore.rules,
# not by hiding these. Leave unset to run fully local with no backend at all.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Base URL for callable Cloud Functions. Only used when the learner explicitly
# opts into cloud inference; the default on-device path never calls it.
VITE_FUNCTIONS_REGION=northamerica-northeast1
