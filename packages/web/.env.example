# Firebase web config. Safe to expose — access is governed by firestore.rules,
# not by hiding these. Leave unset to run fully local with no backend at all.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Base URL for callable Cloud Functions. Only used when the learner explicitly
# opts into cloud inference; the default on-device path never calls it.
VITE_FUNCTIONS_REGION=northamerica-northeast1

# Whether this build offers cloud inference at all. Off unless it is exactly
# "true". The deployed demo and the open-source default are on-device only:
# the server enforces the same posture independently via
# CLOUD_INFERENCE_ENABLED, so neither side is trusted to be the only switch.
VITE_CLOUD_ENABLED=false
